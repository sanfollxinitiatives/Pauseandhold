# ----------------------------------------------------------------------
# MAINTENANCE MODE ENABLED (Pause & Hold Luxury Maintenance)
# ----------------------------------------------------------------------

# 1. Prevent Directory Browsing
Options -Indexes +FollowSymLinks

# 2. Set Default Index to Maintenance Page
DirectoryIndex maintenance.html index.html

# 3. Enable URL Rewriting to Maintenance Page
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect HTTP to HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Allow static assets, images, icons, and styles to load cleanly
  RewriteCond %{REQUEST_URI} ^/images/ [NC,OR]
  RewriteCond %{REQUEST_URI} ^/_next/ [NC,OR]
  RewriteCond %{REQUEST_URI} ^/favicon\.ico [NC,OR]
  RewriteCond %{REQUEST_URI} ^/apple-icon\.png [NC,OR]
  RewriteCond %{REQUEST_URI} ^/icon\.svg [NC,OR]
  RewriteCond %{REQUEST_URI} ^/icon-192\.png [NC,OR]
  RewriteCond %{REQUEST_URI} ^/icon-512\.png [NC,OR]
  RewriteCond %{REQUEST_URI} ^/maintenance\.html$ [NC]
  RewriteRule ^ - [L]

  # Route all other requests to the maintenance page
  RewriteRule ^(.*)$ /maintenance.html [L]
</IfModule>

# 4. Gzip & Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 5. Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
